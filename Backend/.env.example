# Copie este arquivo para .env e preencha somente no arquivo local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=erpweb_app
DB_PASSWORD=troque-por-uma-senha-local-forte
DB_NAME=erp_pai

# Local: development. Hospedagem HTTPS: production.
APP_ENV=development
# Só para Vite em desenvolvimento; produção no mesmo domínio não precisa.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Primeiro acesso na nuvem: gere 32+ caracteres aleatórios, não use o modelo.
# SETUP_TOKEN=
# Certificado CA se o provedor exigir TLS no MySQL:
# DB_SSL_CA=
